{
  "name": "myfinance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run lint && npm run test:unit && npm run test:parity",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:parity": "node --test tests/parity/*.test.js",
    "test:legacy-read": "node tests/parity/headless-browser-legacy.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify && npm run build:styles",
    "build:styles": "node scripts/build-styles.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.112.4",
    "clean-css": "^5.3.3",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.55.0",
    "tailwindcss": "^3.4.19"
  }
}
